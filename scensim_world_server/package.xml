<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_world_server</name>
  <version>0.1.0</version>
  <description>The world protocol's Python shell: a world server's socket, lease, handles and steps around a simulator's World (roadmap 046)</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- The shell imports zmq and google.protobuf (protocol.py reads scensim_world.desc, no
       generated _pb2). rosdep installs both for a source build; a binary install lists them. -->
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
